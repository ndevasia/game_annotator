{
  "name": "game-annotation-tool",
  "version": "1.0.0",
  "description": "Electron base app for gameplay annotation with live note-taking overlay.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "debug": "electron . -- --debug",
    "dist": "electron-builder -m x64 -m arm64",
    "start:control": "electron . -- --condition=control",
    "start:prompt-light": "electron . -- --condition=prompt-light",
    "start:prompt-ai": "electron . -- --condition=prompt-ai"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "aws-sdk": "^2.1692.0",
    "dotenv": "^17.2.1",
    "ffi-rs": "^1.3.1",
    "obs-websocket-js": "^5.0.8"
  },
  "build": {
    "appId": "com.example.gameannotator",
    "productName": "GameAnnotator",
    "files": [
      "**/*",
      "!s3_data/**",
      "!**/s3_data/**"
    ],
    "extraResources": [
      "bin/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
